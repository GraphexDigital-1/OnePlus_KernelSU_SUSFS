From a0bbfabaecc189c5af6f45bd9f1973d6a9a2a4cb Mon Sep 17 00:00:00 2001
From: crash-overlord <crash@overlord.local>
Date: Sun, 15 Nov 2026 16:42:28 +0000
Subject: [PATCH 1/7] mm: skip swap readahead when process is exiting

Port of Kirisakura 16a9a21b4eae (Tim Murray) to 5.10: it's possible for a
user fault to be triggered during task exit that results in swap
readahead, which is not useful. Skip swap readahead if the current
process is exiting.

Signed-off-by: Tim Murray <timmurray@google.com>
---
 mm/swap_state.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/mm/swap_state.c b/mm/swap_state.c
index fa9d13d1d19d..dd8a77b52dc6 100644
--- a/mm/swap_state.c
+++ b/mm/swap_state.c
@@ -689,6 +689,10 @@ struct page *swap_cluster_readahead(swp_entry_t entry, gfp_t gfp_mask,
 			goto skip;
 	}
 
+	/* If exiting, don't do swap readahead. */
+	if (current->flags & PF_EXITING)
+		goto skip;
+
 	do_poll = false;
 	/* Read a page_cluster sized and aligned cluster around offset. */
 	start_offset = offset & ~mask;
