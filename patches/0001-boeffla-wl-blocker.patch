+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ */
+
+#define BOEFFLA_WL_BLOCKER_VERSION	"1.1.0"
+
+#define LIST_WL_DEFAULT				""
+
+#define LENGTH_LIST_WL				255
+#define LENGTH_LIST_WL_DEFAULT		100
+#define LENGTH_LIST_WL_NAME			54
+#define LENGTH_LIST_WL_SEARCH		(LENGTH_LIST_WL + LENGTH_LIST_WL_DEFAULT + 5)
diff --git a/drivers/base/power/wakeup.c b/drivers/base/power/wakeup.c
index f29d4563e687..52fedee00da6 100644
--- a/drivers/base/power/wakeup.c
+++ b/drivers/base/power/wakeup.c
@@ -22,6 +22,16 @@
 
 #include "power.h"
 
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+#include "boeffla_wl_blocker.h"
+
+char list_wl_search[LENGTH_LIST_WL_SEARCH] = {0};
+bool wl_blocker_active = false;
+bool wl_blocker_debug = false;
+
+static void wakeup_source_deactivate(struct wakeup_source *ws);
+#endif
+
 #ifndef CONFIG_SUSPEND
 suspend_state_t pm_suspend_target_state;
 #define pm_suspend_target_state	(PM_SUSPEND_ON)
@@ -612,6 +622,47 @@ static void wakeup_source_activate(struct wakeup_source *ws)
 	trace_wakeup_source_activate(ws->name, cec);
 }
 
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+/* AP: check whether a wakelock is on the wakelock blocker list */
+static bool check_for_block(struct wakeup_source *ws)
+{
+	char wakelock_name[LENGTH_LIST_WL_NAME] = {0};
+	int length;
+
+	if (!ws || !ws->name)
+		return false;
+
+	if (wl_blocker_debug)
+		printk("Boeffla WL blocker: %s requested\n", ws->name);
+
+	if (!wl_blocker_active)
+		return false;
+
+	/* handled wakelock names have max length 50, min 1 */
+	length = strlen(ws->name);
+	if ((length > 50) || (length < 1))
+		return false;
+
+	snprintf(wakelock_name, sizeof(wakelock_name), ";%s;", ws->name);
+
+	if (strstr(list_wl_search, wakelock_name) == NULL)
+		return false;
+
+	if (wl_blocker_debug)
+		printk("Boeffla WL blocker: %s blocked\n", ws->name);
+
+	/* if currently active, deactivate immediately (ws->lock is held) */
+	if (ws->active) {
+		wakeup_source_deactivate(ws);
+
+		if (wl_blocker_debug)
+			printk("Boeffla WL blocker: %s killed\n", ws->name);
+	}
+
+	return true;
+}
+#endif
+
 /**
  * wakeup_source_report_event - Report wakeup event using the given source.
  * @ws: Wakeup source to report the event for.
@@ -619,6 +670,9 @@ static void wakeup_source_activate(struct wakeup_source *ws)
  */
 static void wakeup_source_report_event(struct wakeup_source *ws, bool hard)
 {
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+	if (!check_for_block(ws)) {
+#endif
 	ws->event_count++;
 	/* This is racy, but the counter is approximate anyway. */
 	if (events_check_enabled)
@@ -627,6 +681,10 @@ static void wakeup_source_report_event(struct wakeup_source *ws, bool hard)
 	if (!ws->active)
 		wakeup_source_activate(ws);
 
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+	}
+#endif
+
 	if (hard)
 		pm_system_wakeup();
 }
