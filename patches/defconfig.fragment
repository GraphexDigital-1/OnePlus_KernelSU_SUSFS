CONFIG_BOEFFLA_WL_BLOCKER=y

# Kirisakura backports (patches/0003..0009)
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEFAULT_NET_SCH="fq_codel"
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_DRM_MSM_REGISTER_LOGGING is not set

# Mejoras GKI-safe adicionales (batch 2026-11-15)
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Pack rendimiento v2 (batch 2026-11-16) - GKI-safe: no toca ABI ni modulos
# vendor. Cada linea es reversible por separado; detalle/tradeoffs en
# backport-analysis.md.
#
# Revision 2026-11-26: las dos mitigaciones de memoria vuelven a ON. Apagarlas
# no crea bugs, pero convierte infoleaks y use-after-free existentes (kernel +
# 485 modulos vendor) en cadenas de exploit utiles; coste upstream ~1% y aqui
# nunca se midio ninguna ganancia. UBSAN se queda OFF: solo detecta y loguea,
# no defiende, y es donde estaba el ahorro real de los tres.
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
# CONFIG_UBSAN is not set
# CONFIG_DEBUG_LIST no aplicado: lo fuerza BUG_ON_DATA_CORRUPTION
# (hardening del stock) - desactivarlo exigiria quitar tambien ese BUG_ON.

# OPlus in-tree sensor config (batch 2026-11-25). The new base repo
# (android_kernel_oneplus_sm8450) carries drivers/soc/oplus/sensor in tree and
# drivers/soc/Makefile descends into it unconditionally; its Kconfig is
# "default y", so olddefconfig built it into vmlinux and the link failed on
# qcom_smem_alloc / qcom_smem_get / get_project, which live in stock vendor
# modules. Stock sets this =m (oplus_sensor.ko) and we keep using the stock
# vendor modules, so the in-tree copy is both broken and redundant.
# CONFIG_OPLUS_FEATURE_SENSOR_CFG is not set

# Parity with the known-good 5.10.209 A14 build (batch 2026-11-27). The new base
# repo (android_kernel_oneplus_sm8450, OPlus V/A15 generation) carries in-tree
# Kconfig symbols that the A14 OPlus common kernel did not have at all. They are
# "default y", so olddefconfig turned them on and they changed built-in kernel
# behaviour under the untouched OOS14 vendor stack. The 5.10.269 image hung at
# the 1+ logo with no USB gadget. Full KMI now matches the 209 build (0 CRC
# differences over 7062 symbols, 374/374 vendor_dlkm modules clean), so what is
# left is behaviour, not ABI. UFSFEATURE is the prime suspect: it injects Samsung
# UFS Turbo Write / Host Initiated Defrag code into the built-in ufshcd core on a
# device whose stock kernel never ran it, and UFSTW_BOOT_ENABLED arms it at boot.
# CONFIG_UFSFEATURE is not set
# CONFIG_OPLUS_SYSTEM_KERNEL is not set
# CONFIG_OPLUS_SYSTEM_KERNEL_QCOM is not set
# CONFIG_OPLUS_FEATURE_PERFORMANCE_MM is not set
# CONFIG_OPLUS_FEATURE_PERFORMANCE_SCHED is not set
# CONFIG_DYNAMIC_TUNING_SWAPPINESS is not set
